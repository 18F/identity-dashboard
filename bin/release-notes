#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative 'changelog_check'
require 'io/console'
require 'date'
require 'open3'

Commit = Struct.new(:sha, :title, :commit_messages, keyword_init: true)

RECENT_TAG_COUNT = 3

def run_git(*args)
  output, status = Open3.capture2('git', *args)
  raise "git #{args.join(' ')} failed" unless status.success?

  output
end

def recent_tags
  run_git('tag', '--sort=-creatordate').lines.first(RECENT_TAG_COUNT).map(&:strip)
end

def commit_range(selected_tags, all_tags)
  return "#{selected_tags.first}..main" if selected_tags.length == 1

  newer, older = selected_tags.sort_by { |tag| all_tags.index(tag) }
  "#{older}^..#{newer}"
end

def parse_commit(chunk)
  sha_line, rest = chunk.split("\ntitle:", 2)
  title, body = rest.split("\nbody:", 2)
  Commit.new(
    sha: sha_line.delete_prefix('sha:').strip,
    title: title.strip,
    commit_messages: body.to_s.split(/[\r\n]/).filter { |line| line != '' },
  )
end

def commits_since(range)
  format = '--format=sha:%H%ntitle:%s%nbody:%b%nDELIMITER'
  log = run_git('log', format, range)

  log.strip.split('DELIMITER').map(&:strip).reject(&:empty?).map { |chunk| parse_commit(chunk) }
end

def render_selectable_list(items, checked, cursor, first_render)
  print "\e[#{items.length}A" unless first_render

  items.each_with_index do |item, index|
    pointer = index == cursor ? '>' : ' '
    checkbox = checked[index] ? '[x]' : '[ ]'
    print "\e[2K\r#{pointer} #{checkbox} #{yield(item)}\n"
  end
end

def read_key
  key = $stdin.getch
  return key unless key == "\e"

  key << $stdin.getch
  key << $stdin.getch if key == "\e["
  key
end

# Renders an interactive checklist and returns the checked items. Arrow keys move the cursor and
# enter confirms; any other key is passed to the block along with the checked/cursor state so the
# caller can decide how it toggles selection (e.g. capping the number of checked items).
def pick_items(items, header, format_item: :itself.to_proc)
  puts header
  puts

  checked = Array.new(items.length, false)
  cursor = 0
  render = lambda { |first_render|
    render_selectable_list(items, checked, cursor, first_render, &format_item)
  }
  render.call(true)

  loop do
    key = read_key
    case key
    when "\e[A" then cursor = (cursor - 1) % items.length
    when "\e[B" then cursor = (cursor + 1) % items.length
    when "\r", "\n" then break
    when 'q', "\u0003" then abort("\nAborted.")
    else yield(key, checked, cursor)
    end
    render.call(false)
  end

  puts
  items.select.with_index { |_, index| checked[index] }
end

def prompt_tag_selection(tags)
  header = "Most recent tags:\n\n" \
    "Up/down to move, space to toggle (max 2), enter to confirm, q to quit.\n\n" \
    'Select one tag to gather commits from it to now, or two tags for the commits between them.'

  selected = pick_items(tags, header) do |key, checked, cursor|
    next unless key == ' '

    if checked[cursor]
      checked[cursor] = false
    elsif checked.count(true) < 2
      checked[cursor] = true
    end
  end

  abort('Select at least one tag.') if selected.empty?
  selected
end

def prompt_selection(commits, range)
  header = "Commits in #{range}:\n\n" \
    "Up/down to move, space to toggle, 'a' to toggle all, enter to confirm, q to quit.\n\n"
  format_item = ->(commit) { "#{commit.sha[0, 8]} #{commit.title}" }

  pick_items(commits, header, format_item: format_item) do |key, checked, cursor|
    case key
    when ' ' then checked[cursor] = !checked[cursor]
    when 'a'
      target = !checked.all?
      checked.map! { target }
    end
  end
end

def build_entries(commits)
  commits.filter_map do |commit|
    change = build_changelog_from_commit(commit)
    next unless change

    category = closest_change_category(change)
    next unless category

    ChangelogEntry.new(
      category: category,
      subcategory: change[:subcategory].strip.sub(/./, &:upcase),
      change: change[:change].strip.sub(/./, &:upcase),
    )
  end
end

def print_category(category, entries)
  puts "\n#{category}"
  puts '-' * category.length
  entries.group_by(&:subcategory).each do |subcategory, subcategory_entries|
    puts "  #{subcategory}:"
    subcategory_entries.each { |entry| puts "    - #{entry.change}" }
  end
end

def print_release_notes(entries)
  if entries.empty?
    puts "\nNo changelog entries found in the selected commits."
    return
  end

  puts "\nRelease Notes\n#{'=' * 13}"
  CATEGORIES.each do |category|
    category_entries = entries.select { |entry| entry.category == category }
    next if category_entries.empty?

    print_category(category, category_entries)
  end
end

# Assumes identity-dev-docs is in the same directory as identity-dashboard.
module DevDocs
  DIR = File.expand_path('../../identity-dev-docs', __dir__)
  RELEASE_NOTES_FILE = File.join(DIR, '_pages/release-notes.md')
  ACCORDION_LIST_START = /(<dl class="usa-accordion usa-accordion--bordered">\n\n)/

  module_function

  def git(*)
    run_git('-C', DIR, *)
  end

  def accordion_content(entries)
    CATEGORIES.filter_map do |category|
      category_entries = entries.select { |entry| entry.category == category }
      next if category_entries.empty?

      "### #{category}\n" + category_entries.map { |entry| "* #{entry.change}" }.join("\n")
    end.join("\n\n")
  end

  def accordion_block(today, entries)
    indent = ' ' * 26 # aligns with '{% include accordion.html '
    <<~BLOCK
      {% include accordion.html id="track-#{today}"
      #{indent}accordion_id="user-key-#{today}"
      #{indent}title="#{today}"
      #{indent}content="
      #{accordion_content(entries)}"
      %}

    BLOCK
  end

  def uncommitted_changes?
    !git('status', '--porcelain').strip.empty?
  end

  def sync_main
    if uncommitted_changes?
      abort("#{DIR} has uncommitted changes. Commit or stash them before continuing.")
    end

    git('checkout', 'main')
    git('pull')
  end

  def write_release_notes(today, entries)
    page = File.read(RELEASE_NOTES_FILE)
    replacement = "\\1#{accordion_block(today, entries)}"
    File.write(RELEASE_NOTES_FILE, page.sub(ACCORDION_LIST_START, replacement))
  end

  def commit_release_notes(today)
    username, = Open3.capture2('whoami')
    branch = "#{username.strip}/release-notes/rc-#{today}"
    git('checkout', '-b', branch)
    git('add', '_pages/release-notes.md')
    git('commit', '-m', "Release Notes for RC #{today}")
    branch
  end

  def push_branch(branch)
    puts git('show', '--color=always', 'HEAD')
    return unless confirm?("\nPush #{branch} to origin?")

    puts git('push', '-u', 'origin', branch)
  end
end

def confirm?(message)
  print "#{message} (y/n): "
  $stdin.gets.to_s.strip.casecmp('y').zero?
end

def publish_release_notes(entries)
  excluded_categories = ['Internal', 'Upcoming Features']
  public_entries = entries.reject { |entry| excluded_categories.include?(entry.category) }
  return if public_entries.empty?

  return unless confirm?("\nUpdate #{DevDocs::RELEASE_NOTES_FILE} with these release notes?")

  today = Date.today.strftime('%Y-%m-%d') # rubocop:disable Rails/Date -- standalone script, no Rails/ActiveSupport loaded
  DevDocs.sync_main
  DevDocs.write_release_notes(today, public_entries)

  branch = DevDocs.commit_release_notes(today)
  DevDocs.push_branch(branch)
end

def run_release_notes
  tags = recent_tags
  abort('No tags found') if tags.empty?

  selected_tags = prompt_tag_selection(tags)
  range = commit_range(selected_tags, tags)
  commits = commits_since(range)
  if commits.empty?
    puts "No commits found for #{range}."
    return
  end

  selected_commits = prompt_selection(commits, range)
  entries = build_entries(selected_commits)
  print_release_notes(entries)
  publish_release_notes(entries)
end

run_release_notes if __FILE__ == $PROGRAM_NAME
