<fieldset class="usa-fieldset usa_collection_select" id="reports_form">
  <% unless @graphs_ready %>
    <p class="margin-bottom-0">Choose from the dropdowns to see a report.</p>
  <% end %>
  <div class="grid-row grid-gap-2">
    <%= render partial: 'report_select_input', locals: {
      name: 'team',
      label: I18n.t('reports.inputs.labels.team'),
      collection: teams_collection_for_select(@teams),
      all_controls: all_app_options_string(@teams),
      required: false,
      selected: @team,
      prompt: I18n.t('reports.inputs.prompts.team'),
    } %>
    <%= render partial: 'report_select_input', locals: {
      name: 'uuid',
      label: I18n.t('reports.inputs.labels.app'),
      collection: service_providers_collection_for_select(@available_service_providers),
      required: true,
      selected: @analytic.config ? @analytic.config&.uuid : '',
      prompt: @application_count.zero? ? I18n.t('reports.inputs.prompts.no_app') : I18n.t('reports.inputs.prompts.app')
    } %>
    <%= render partial: 'report_select_input', locals: {
      name: 'date',
      label: I18n.t('reports.inputs.labels.date'),
      collection: dates_collection_for_select(@dates),
      required: true,
      selected: @analytic.date,
      prompt: I18n.t('reports.inputs.prompts.date')
    } %>
  </div>
</fieldset>
